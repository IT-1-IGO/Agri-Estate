import React from 'react';
import SEO from '../components/SEO';
import { motion, useReducedMotion } from 'framer-motion';
import { ShieldCheck, Target, Users, Landmark } from 'lucide-react';

interface AboutProps {
  /** false when this component is embedded as a section inside another page (e.g. the homepage),
   * so it doesn't emit a duplicate <h1>/SEO tags for that page. Defaults to true (standalone /about route). */
  standalone?: boolean;
}

const About: React.FC<AboutProps> = ({ standalone = true }) => {
  const Heading = standalone ? 'h1' : 'h2';
  const reduce = useReducedMotion();
  const EASE = [0.22, 1, 0.36, 1] as const;
  // Fade + rise, played once when the element scrolls into view; disabled for reduced-motion users
  const reveal = (delay = 0, y = 24) => ({
    initial: reduce ? false as const : { opacity: 0, y },
    whileInView: { opacity: 1, y: 0 },
    viewport: { once: true, margin: '-60px' },
    transition: { duration: 0.7, ease: EASE, delay },
  });
  return (
    <section id="about" className="py-20 bg-background">
      {standalone && (
        <SEO
          title="About IGO Agri Estates — India's Premier Agricultural Land Platform"
          description="IGO Agri Estates is the land arm of IGO Group of Companies. We buy and sell agricultural land directly and offer land with IGO Agri Tech farm projects."
          canonical="/about"
          keywords="IGO Agri Estates about, agricultural land company India, farmland investment company India, agri estate company, managed farmland India, farm land developer Tamil Nadu Karnataka Maharashtra"
          ogImage="https://www.igoagriestate.com/images/team-expert-indian.png"
          schema={[
            {
              '@context': 'https://schema.org',
              '@type': 'AboutPage',
              name: "About IGO Agri Estates",
              url: 'https://www.igoagriestate.com/about',
              mainEntity: { '@id': 'https://www.igoagriestate.com/#organization' },
              description: "IGO Agri Estates is the land arm of IGO Group of Companies, buying and selling agricultural land directly and offering land with IGO Agri Tech farm projects."
            },
            {
              '@context': 'https://schema.org',
              '@type': 'BreadcrumbList',
              itemListElement: [
                { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.igoagriestate.com/' },
                { '@type': 'ListItem', position: 2, name: 'About', item: 'https://www.igoagriestate.com/about' }
              ]
            }
          ]}
        />
      )}
      <div className="container-pro">
        <div className="max-w-4xl mx-auto text-center mb-20">
          <motion.p {...reveal(0, 16)} className="text-[10px] font-black text-[#00814a] uppercase tracking-[0.5em] mb-6">Our Legacy</motion.p>
          <motion.div {...reveal(0.12)}>
            <Heading className="text-6xl font-black text-primary uppercase tracking-tighter leading-none mb-8">
              The Institution <br />of{' '}
              <motion.span
                className="text-secondary italic font-serif inline-block"
                initial={reduce ? false : { opacity: 0, y: 10, filter: 'blur(4px)' }}
                whileInView={{ opacity: 1, y: 0, filter: 'blur(0px)' }}
                viewport={{ once: true, margin: '-60px' }}
                transition={{ duration: 0.9, ease: EASE, delay: 0.5 }}
              >Agricultural Land</motion.span>
            </Heading>
          </motion.div>
          <motion.p {...reveal(0.26)} className="text-xl text-text-muted font-light leading-relaxed">
            IGO Agri Estates is the land arm of IGO Group of Companies, buying and selling agricultural land directly. We bridge the gap between traditional land ownership and modern investment excellence.
          </motion.p>
        </div>

        <div className="grid md:grid-cols-2 gap-16 items-center mb-32">
          <div className="space-y-8">
            <motion.h2 {...reveal(0, 20)} className="text-4xl font-black text-primary uppercase tracking-tight">Our Mission</motion.h2>
            <motion.p {...reveal(0.14, 20)} className="text-text-muted leading-relaxed">
              To democratize agricultural land ownership by providing institutional-grade transparency, scientific agronomy support, and secure title management. We believe land is the ultimate asset, and our goal is to make it productive and profitable for every investor.
            </motion.p>
          </div>
          <motion.div
            initial={reduce ? false : { opacity: 0, scale: 0.96 }}
            whileInView={{ opacity: 1, scale: 1 }}
            viewport={{ once: true, margin: '-60px' }}
            transition={{ duration: 0.8, ease: EASE, delay: 0.1 }}
            className="group rounded-[40px] overflow-hidden shadow-2xl h-[500px]"
          >
             <img 
               src="/images/team-expert-indian.png" 
               alt="IGO Agri Estates expert team — agricultural land investment specialists in Tamil Nadu, India"
               className="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.04]"
             />
          </motion.div>
        </div>

        <div className="grid md:grid-cols-4 gap-8 mb-32">
          {[
            { icon: <ShieldCheck className="text-secondary transition-colors duration-500 group-hover:text-primary" />, title: 'Title Security', desc: 'Rigorous 30-year title verification for every asset.' },
            { icon: <Target className="text-secondary transition-colors duration-500 group-hover:text-primary" />, title: 'Scientific ROI', desc: 'Data-driven crop projections and yield analysis.' },
            { icon: <Users className="text-secondary transition-colors duration-500 group-hover:text-primary" />, title: 'Expert Support', desc: 'Dedicated agronomy and legal desks at your service.' },
            { icon: <Landmark className="text-secondary transition-colors duration-500 group-hover:text-primary" />, title: 'Compliance', desc: 'Full adherence to state-specific agricultural laws.' }
          ].map((item, i) => (
            <motion.div
              key={i}
              {...reveal(i * 0.12, 28)}
              whileHover={reduce ? undefined : { y: -6, transition: { duration: 0.4, ease: EASE } }}
              className="group h-full p-10 bg-white border border-black/5 rounded-[32px] shadow-sm hover:shadow-2xl transition-shadow duration-500"
            >
              <div className="mb-6">{item.icon}</div>
              <h3 className="text-lg font-black text-primary uppercase mb-3">{item.title}</h3>
              <p className="text-sm text-text-muted leading-relaxed">{item.desc}</p>
            </motion.div>
          ))}
        </div>
      </div>
    </section>
  );
};

export default About;
