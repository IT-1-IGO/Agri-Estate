import React from 'react';
import { motion, useReducedMotion } from 'framer-motion';
import { Sprout, LayoutGrid, Users, ShieldCheck } from 'lucide-react';

const EASE = [0.22, 1, 0.36, 1] as const;

const FEATURES = [
  { Icon: Sprout, title: 'Crop Model First', desc: 'Every estate is explained with a practical crop plan and revenue route.' },
  { Icon: LayoutGrid, title: 'Estate Budgeting', desc: 'Understand setup cost, operating cost, crop cycle, and break-even before deciding.' },
  { Icon: Users, title: 'Managed Farming', desc: 'IGO supports farm development, labour management, and operations.' },
  { Icon: ShieldCheck, title: 'Document Clarity', desc: 'Land purchase is supported with title, survey, tax, and legal documentation.' },
];

const Leaf: React.FC<{ className?: string }> = ({ className }) => (
  <svg viewBox="0 0 120 220" className={className} fill="currentColor" aria-hidden="true">
    <path d="M60 215c-2-60-1-110 4-205 20 30 38 60 30 100-6 30-20 55-34 105z" opacity=".9" />
    <path d="M58 150c-30-8-48-30-52-62 28 4 48 20 54 50z" opacity=".75" />
    <path d="M64 120c26-10 42-32 46-64-26 6-44 24-50 52z" opacity=".75" />
    <path d="M60 80c-22-8-34-26-36-50 22 4 34 18 38 42z" opacity=".6" />
  </svg>
);

const WhyChooseAgriEstates: React.FC = () => {
  const reduce = useReducedMotion();
  const reveal = (delay = 0, y = 24) => ({
    initial: reduce ? false as const : { opacity: 0, y },
    whileInView: { opacity: 1, y: 0 },
    viewport: { once: true, margin: '-60px' },
    transition: { duration: 0.6, ease: EASE, delay },
  });

  return (
    <section className="relative overflow-hidden bg-gradient-to-b from-[#f6faf3] to-[#e9f2e5] py-16 lg:py-24" aria-labelledby="why-igo-heading">
      <Leaf className="pointer-events-none absolute -left-10 bottom-4 hidden h-72 w-40 -rotate-12 text-[#1B5E20] opacity-[0.07] md:block" />
      <Leaf className="pointer-events-none absolute -right-8 bottom-0 hidden h-80 w-44 rotate-[18deg] scale-x-[-1] text-[#1B5E20] opacity-[0.07] md:block" />

      <div className="container-pro relative">
        <div className="grid items-center gap-10 lg:grid-cols-[1.25fr_0.9fr] lg:gap-14">
          <div className="min-w-0">
            <motion.span {...reveal(0, 16)} className="block text-xs font-extrabold uppercase tracking-[0.3em] text-[#A96D0A]">Why choose IGO Agriestates?</motion.span>
            <motion.h2 {...reveal(0.1)} id="why-igo-heading" className="mt-3 text-4xl font-extrabold normal-case leading-[1.05] tracking-tight text-[#075334] sm:text-5xl lg:text-[3.4rem]">
              Why Choose <br />
              <span className="italic text-[#A96D0A]">Igo Agriestates?</span>
            </motion.h2>
            <motion.p {...reveal(0.2)} className="mt-5 max-w-xl text-base leading-relaxed text-slate-500 sm:text-lg">
              We help customers evaluate agricultural land and convert it into a professionally planned Agri Estate with crop strategy, development budgeting, managed operations, and transparent revenue tracking.
            </motion.p>
            <motion.div {...reveal(0.28, 8)} className="mt-5 h-[2px] w-16 rounded-full bg-[#A96D0A]" />

            <div className="mt-8 grid grid-cols-1 gap-5 min-[480px]:grid-cols-2">
              {FEATURES.map(({ Icon, title, desc }, i) => (
                <motion.div
                  key={title}
                  {...reveal(0.15 + i * 0.1, 28)}
                  whileHover={reduce ? undefined : { y: -5, transition: { duration: 0.35, ease: EASE } }}
                  className="group flex h-full flex-col rounded-[20px] border border-[#0f4d24]/10 bg-white/85 p-6 shadow-[0_12px_30px_-22px_rgba(15,77,36,0.45)] transition-shadow duration-500 hover:shadow-[0_24px_44px_-22px_rgba(15,77,36,0.55)]"
                >
                  <span className="flex h-12 w-12 items-center justify-center rounded-2xl bg-[#e3efdd] text-[#A96D0A]"><Icon size={22} /></span>
                  <h3 className="mt-4 text-base font-extrabold uppercase tracking-wide text-[#075334]">{title}</h3>
                  <p className="mt-2 text-sm leading-relaxed text-slate-500">{desc}</p>
                </motion.div>
              ))}
            </div>
          </div>

          <motion.div
            {...reveal(0.2, 32)}
            className="group relative aspect-[4/3] w-full overflow-hidden rounded-[28px] shadow-[0_24px_50px_-30px_rgba(15,77,36,0.55)]"
          >
            <img
              src="/images/why/why-igo-agent-consultation.webp"
              alt="IGO field agent in a black IGO polo explaining farm details on a tablet to a farmer and a customer in a green crop field"
              width={1624}
              height={1208}
              loading="lazy"
              decoding="async"
              className="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
            />
          </motion.div>
        </div>
      </div>
    </section>
  );
};

export default WhyChooseAgriEstates;
