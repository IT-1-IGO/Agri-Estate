.bm{color:#0b3d13;background:#fff;padding:clamp(40px,4.5vw,80px) 0;position:relative;overflow:hidden;font-family:"DM Sans",inherit,sans-serif}
.bmHead{text-align:center;margin-bottom:clamp(24px,2.6vw,44px);padding:0 5vw}
.bmEye{letter-spacing:.3em;color:#478427;justify-content:center;align-items:center;gap:16px;margin:0 0 12px;font-size:.8rem;font-weight:700;display:flex}
.bmEye span{opacity:.7;background:#478427;width:40px;height:1px}
.bm h2{letter-spacing:-.02em;color:#0b3d13;margin:0;font-size:clamp(1.8rem,3.2vw,3rem);font-weight:800;line-height:1.1}
.bm h2 em{color:#478427;font-style:normal}
.bmView{width:100%;overflow:hidden;-webkit-mask-image:linear-gradient(90deg,transparent 0,#000 6%,#000 94%,transparent 100%);mask-image:linear-gradient(90deg,transparent 0,#000 6%,#000 94%,transparent 100%)}
.bmTrack{will-change:transform;width:max-content;animation:bmMove 85s linear infinite;display:flex}
.bmView:hover .bmTrack,.bmView:focus-within .bmTrack{animation-play-state:paused}
.bmSet{flex:0 0 auto;margin:0;padding:6px 0 10px;list-style:none;display:flex}
.bmCard{flex:0 0 auto;width:180px;margin-right:20px;display:flex}
.bmCard a{width:100%;min-height:96px;text-align:center;background:#fff;border:1px solid #e3ebdc;border-radius:20px;display:flex;align-items:center;justify-content:center;padding:14px 12px 16px;box-shadow:0 6px 18px rgba(11,61,19,.07);color:#0b3d13;text-decoration:none;transition:transform .3s,box-shadow .3s,border-color .3s,color .3s}
.bmCard b{color:inherit;font-size:.86rem;font-weight:700;line-height:1.3;transition:color .3s}
.bmCard a:hover,.bmCard a:focus-visible{transform:translateY(-4px);border-color:#478427;box-shadow:0 12px 26px rgba(11,61,19,.15);color:#06290d}
@keyframes bmMove{0%{transform:translate(0)}100%{transform:translate(-50%)}}
@media (max-width:700px){.bmCard{width:140px;margin-right:14px}.bmCard a{border-radius:16px;padding:10px 8px 12px;min-height:80px}.bmCard b{font-size:.76rem}.bmTrack{animation-duration:70s}}
@media (prefers-reduced-motion:reduce){.bmTrack{animation:none}.bmView{overflow-x:auto;-webkit-mask-image:none;mask-image:none}.bmSet[aria-hidden]{display:none}}
