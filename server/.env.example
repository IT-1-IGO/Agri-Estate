# Copy to .env and fill in. Never commit the real .env.
PORT=4000
# Comma separated list of website origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,https://agri-estate-rosy.vercel.app
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=igo_agri
DB_PASSWORD=
DB_NAME=igo_agri_estate
# Long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
# First Super Admin, created by `npm run seed` (password is generated and printed if left blank)
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_USERNAME=superadmin
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Uploaded files are stored here (use a persistent disk in production)
UPLOAD_DIR=./uploads
PUBLIC_BASE_URL=http://localhost:4000
